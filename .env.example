PORT=5000
NODE_ENV=development
HOST=127.0.0.1
# Master switch, disabled by default. OpenAI replies require true and AI_PROVIDER=openai.
AUTOMATION_ENABLED=false

# Generate a random secret locally; at least 32 characters in production.
WEBHOOK_VERIFY_TOKEN=
# Nonempty enables HMAC validation for every webhook POST. Set before public ngrok tests.
# Blank permits unsigned localhost development only. Required in production or automation.
META_APP_SECRET=
# Optional for receipt, required for sending; this setup uses v25.0.
META_GRAPH_API_VERSION=
# Numeric when set: optional receive filter, required for sending.
WHATSAPP_PHONE_NUMBER_ID=
# Optional for webhook receipt; required for manual sends or automatic replies.
WHATSAPP_ACCESS_TOKEN=
# Optional private CLI input. Blank values prompt locally; never put real values here.
WHATSAPP_TEST_TO=
WHATSAPP_TEST_TEXT=
# Optional receive filter; comma-separated sender numbers with country codes.
ALLOWED_SENDER_PHONES=
# Boss lead workflow; blank disables boss authorization. Customers keep conversational AI.
# Comma-separated international numbers, or safely recognized UAE local numbers.
AUTHORIZED_BOSS_PHONES=
# Legacy BOSS_SENDER_PHONES is used only if AUTHORIZED_BOSS_PHONES is absent.
# Private dashboard login. Configure both values for browser access.
# Passwords require at least 8 characters. Never place real credentials in source.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional API bearer credential through the same admin middleware (32-256 visible ASCII characters).
# Leave blank to use dashboard sessions only; never embed it in browser JavaScript or URLs.
ADMIN_API_TOKEN=

# Conversational replies. Leave AI_PROVIDER blank only to retain the fixed-reply mode.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Central Model Routing tiers (deterministic routing based on complexity)
OPENAI_MODEL_DEFAULT=gpt-5.6-luna
OPENAI_MODEL_MEDIUM=gpt-5.6-terra
OPENAI_MODEL_HIGH=gpt-5.6-sol
# Dedicated voice transcription model
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Legacy single-model fallback (used if OPENAI_MODEL_DEFAULT is not configured)
OPENAI_MODEL=gpt-6-astra
# Preserved extraction-only provider; never used by the conversational worker.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=20000
# Total generated tokens, including reasoning; increase only if validated requests truncate.
# Reasoning-capable models use low reasoning effort. Existing reply/lead validation limits still apply.
AI_MAX_OUTPUT_TOKENS=512
# Independent image/document OCR output limit; does not lengthen customer replies.
AI_MEDIA_MAX_OUTPUT_TOKENS=4096
# Optional voice transcription model; uses the existing OPENAI_API_KEY.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Zoho CRM remains disconnected. Internal lead storage uses the existing database.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Choose the accounts and API hosts for your Zoho data center.
ZOHO_ACCOUNTS_URL=
# Include /crm/v8 (or your verified supported version) after the API hostname.
ZOHO_API_BASE_URL=
# Optional JSON overrides using actual field API names, not display labels.
ZOHO_FIELD_MAPPING=
ZOHO_TIMEOUT_MS=15000

# Blank uses file:./data/messages.sqlite in development.
# Production requires PostgreSQL. Keep credentials in deployment secrets.
DATABASE_URL=
# Optional Atlas connection; existing WhatsApp storage continues using DATABASE_URL.
# Paste the real Atlas driver URI privately in .env. Blank skips MongoDB startup.
MONGODB_URI=
WORKER_POLL_MS=1000
WORKER_LEASE_MS=120000
PROCESSING_MAX_ATTEMPTS=3
LOG_LEVEL=info
# Per-IP per-minute bound; add distributed limits at the reverse proxy for replicas.
WEBHOOK_RATE_LIMIT=600
# Set only when the actual reverse proxy topology is known.
TRUST_PROXY_HOPS=0
# Optional comma-separated browser origins. Meta webhook calls do not need CORS.
CORS_ORIGINS=

# Backward-compatible aliases; prefer the META_* variables above.
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
